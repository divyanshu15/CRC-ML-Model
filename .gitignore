# Python Environment & Bytecode
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# macOS Specific
.DS_Store
.AppleDouble
.LSOverride
._*

# Raw individual CEL/FASTQ/BAM sequencing files
data/raw/*/*.cel
data/raw/*/*.CEL.gz
data/raw/*/*.fastq.gz
data/raw/*/*.bam

# Keep directory tracking
!.gitkeep

# Models and temporary caches
models/*/*.joblib
!models/*/.gitkeep
results/figures/*.png
results/figures/*.pdf
!results/figures/.gitkeep

# Local Agent & IDE files
.vscode/
.idea/
*.log
logs/*.log
!logs/.gitkeep


# Data (re-downloadable from GEO / UCSC Xena; regenerated by the pipeline; ~1 GB)
data/raw/
data/processed/
data/external_validation/

# Pre-audit archive: keep code/docs/tables, skip binary model artefacts
archive/**/*.joblib
archive/**/*.png
archive/**/*.pdf

# Local Claude Code launch config
.claude/
