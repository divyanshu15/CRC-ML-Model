# Python Environment & Bytecode
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# macOS Specific
.DS_Store
.AppleDouble
.LSOverride
._*

# Raw individual CEL/FASTQ/BAM sequencing files
data/raw/*/*.cel
data/raw/*/*.CEL.gz
data/raw/*/*.fastq.gz
data/raw/*/*.bam

# Keep directory tracking
!.gitkeep

# Local Agent & IDE files
.vscode/
.idea/
*.log
logs/*.log
!logs/.gitkeep
.impeccable/

# Pre-audit archive: keep code/docs/tables, skip binary model artefacts
archive/**/*.joblib
archive/**/*.png
archive/**/*.pdf

# Local Claude Code launch config
.claude/
